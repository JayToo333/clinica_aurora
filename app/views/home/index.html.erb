<h1>Clínica Aurora</h1>

<p>Site em desenvolvimento, demonstração apenas!</p>

<h2>Encontre seu profissional</h2>

<%= form_with url: professionals_path, method: :get do %>
  <div>
    <%= label_tag :specialty_id, "Especialidade" %>
    <%= select_tag :specialty_id,
      options_from_collection_for_select(@specialties, :id, :name),
      prompt: "Selecione uma especialidade",
      required: true %>
  </div>

  <%= submit_tag "Buscar profissionais" %>
<% end %>