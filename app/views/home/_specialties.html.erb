<article>
  <% @specialties.each do |specialty| %>
    <h3><%= specialty.name %></h3>

    <p>
      <%= number_to_currency(
        specialty.price_cents / 100.0,
        unit: "R$ ",
        separator: ",",
        delimiter: "."
      ) %>
    </p>

    </p>
      <%= link_to "Ver profissionais >", professionals_path(specialty_id: specialty[:id]) %>
    </p>
  <% end %>
</article>